            <CheatEntry>
              <ID>1030</ID>
              <Description>"Ammo Won't Decrease  (affects AI too)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23
  Author : Administrator

  TAmmoStock is for each weapon
  look for function that deducts ammo clip, not from ammo stock. Ammo clip = Salvo Length
  TAmmoStock+30 -&gt; xxx+4 = ammo remaining in clip, then find what writes to it
}

[ENABLE]

aobscanmodule(Ammo1_AOB,$process,8B ?? 04 39 ?? 89 ?? 0F 4C ?? 29 ?? 89 ?? 04)
alloc(newmem,$1000)

label(code)
label(return)
label(Ammo1_AOB_bytes)

newmem:
  reassemble(Ammo1_AOB)    // mov ecx,[rax+04]
  reassemble(Ammo1_AOB+3)  // cmp ecx,edi
  reassemble(Ammo1_AOB+3+2)  // mov edx,edi
  reassemble(Ammo1_AOB+3+2+2)  // cmovl edx,ecx
  // reassemble(Ammo1_AOB+3+2+2+3)  // sub ecx,edx &lt;--no subtraction of ammo clip
  reassemble(Ammo1_AOB+3+2+2+3+2)  // mov [rax+04],ecx

code:
  jmp return

Ammo1_AOB_bytes:
  readmem(Ammo1_AOB,15)

Ammo1_AOB:
  jmp far newmem
  nop
return:
registersymbol(Ammo1_AOB Ammo1_AOB_bytes)


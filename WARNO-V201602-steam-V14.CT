            <CheatEntry>
              <ID>960</ID>
              <Description>"Unlimited Fuel (Player Only)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v189668
  Date   : 2026-05-09

  (unknown location) = unit's MaxFuel
  TFuelModule+18 = unit's currentFuel
}

[ENABLE]
aobscanmodule(FuelAOB,$process,F3 45 0F 11 ?? 18 4C 89 ?? E8)
alloc(newmem,$1000,FuelAOB)
label(code)
label(return)
label(cleanup)
label(FuelAOB_bytes)

// rcx = unit's Eugen::IA::TFuelModule instance
// ArrayOfTeamLinkModule = start address of array of Eugen::IA::TLinkTeamModule instances
// HumanPlayerTeamID = example 0000000002030000,0000000002040000,0000000002050000,etc

newmem:
  // run original code first
  readmem(FuelAOB,6)  // movss [r15+18],xmm8

  // don't use r15 and xmm8
  push r12
  push r14
  push rdx
  mov rdx,[r15+8]  // get raw unit ID from TFuelModule
  cmp rdx,-1  // check if register is 0xFFFFFFFFFFFFFFFF
  je cleanup
  shr rdx,28
  and edx,007FFFFF
  mov r12,ArrayOfTeamLinkModuleSize
  mov r14,[r12]
  cmp edx,r14d   // make sure array index doesn't cause us to exceed array size
  jae cleanup    // jmp to exit if unitID above or equal to max unitID
  // if we reach here, rdx is ready to be used as array index

  mov r12,ArrayOfTeamLinkModule
  mov r14,[r12]
  mov r14,[r14+rdx*8]
  and r14,-02  // now r14 has the Eugen::IA::TLinkTeamModule instance of affected unit
  test r14,r14  // test if we got some zero garbage
  je cleanup

  // compare the unit ID from TFuelModule with the one from TLinkTeamModule
  mov rdx,[r14+8]   // r14 = affected unit ID from TLinkTeamModule
  cmp [r15+8],rdx
  jne cleanup       // get out man, somethin not right here if don't match

  mov r12,HumanPlayerTeamID
  mov rdx,[r12]
  cmp [r14+18],rdx  // take faction ID from TLinkTeamModule and compare it against HumanPlayerTeamID
  jne cleanup       // not human player, no cheats for u

  // set current fuel to minimum amount
  mov dword ptr [r15+18],(float)1000

cleanup:
  pop rdx
  pop r14
  pop r12
  jmp code
code:
  jmp return

FuelAOB_bytes:
  readmem(FuelAOB,6)

FuelAOB:
  jmp newmem
  nop
return:
registersymbol(FuelAOB FuelAOB_bytes)

[DISABLE]
FuelAOB:
  readmem(FuelAOB_bytes,6)

unregistersymbol(*)
dealloc(*)


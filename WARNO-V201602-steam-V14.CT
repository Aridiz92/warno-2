newmem2:
  // run orig code first
  // [WARNO.exe+3F3BAE8] = pointer to Eugen::IA::TGameplayServices
  reassemble(GetPlayerTeamID+7)  // mov byte ptr [rsi+000000C0],01
  reassemble(GetPlayerTeamID+7+7)  // mov rdx,[WARNO.exe+3F3BAE8]

code2:
  push rax
  mov rax,[rdx+30]
  mov [HumanPlayerTeamID],rax
  pop rax
  jmp return2


            <CheatEntry>
              <ID>929</ID>
              <Description>"Unlimited Supplies (Player only)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v178863
  Date   : 2026-01-25
  Author : Administrator

  This script gets AOB that writes to supply units' supply amount
  Eugen::IA::TSupplyModuleInstance
         +18(float)=max supply  +1C(int32)= current supply x 1000
}

[ENABLE]

aobscanmodule(UnlimitedSupplyAOB,$process,0F 11 48 10 0F 11 00 5D E9 1F) // should be unique
alloc(newmem,$1000,UnlimitedSupplyAOB)

label(code)
label(return)
label(cleanup)
label(UnlimitedSupplyAOB_bytes)

newmem:
  // run orig codes first
  readmem(UnlimitedSupplyAOB,7)

  // ArrayOfTeamLinkModule = start address of array of Eugen::IA::TLinkTeamModule instances
  // HumanPlayerTeamID = example 0000000002030000,0000000002040000,0000000002050000,etc
  // make sure  rcx = Eugen::IA::TSupplyModuleInstance
  // don't use rcx
  push r12
  push r13
  push r14
  push rdx
  pushfq
  mov rdx,[rcx+8]  // get raw unit ID from TSupplyModuleInstance
  shr rdx,28
  and edx,007FFFFF  // now rdx is ready to be used as array index

  mov r13,ArrayOfTeamLinkModule
  mov r14,[r13]
  mov r14,[r14+rdx*8]
  and r14,-02  // now r14 has the Eugen::IA::TLinkTeamModule instance of affected unit
  test r14,r14  // test if we got some zero garbage
  je cleanup

  // compare the unit ID from TSupplyModuleInstance with the one from TLinkTeamModule
  mov rdx,[r14+8]   // r14 = affected unit ID from TLinkTeamModule
  cmp [rcx+8],rdx
  jne cleanup       // get out man, somethin not right here if don't match

  mov r13,HumanPlayerTeamID
  mov rdx,[r13]
  cmp [r14+20],rdx  // take faction ID from TLinkTeamModule and compare it against HumanPlayerTeamID
  jne cleanup       // jump if not human player, no cheats for u

  // cheating part
  cvttss2si r12d,[rcx+18]  // take float maxSupply and convert to int32
  imul r12d,#1000          // int32 x 1000
  mov [rcx+1C],r12d       // set current supply to max supply
  jmp cleanup

cleanup:
  popfq
  pop rdx
  pop r14
  pop r13
  pop r12
  jmp code
code:
  jmp return

UnlimitedSupplyAOB_bytes:
  readmem(UnlimitedSupplyAOB,7)

UnlimitedSupplyAOB:
  jmp newmem
  nop 2
return:
registersymbol(UnlimitedSupplyAOB UnlimitedSupplyAOB_bytes)

[DISABLE]

UnlimitedSupplyAOB:
  readmem(UnlimitedSupplyAOB_bytes,7)
unregistersymbol(*)
dealloc(*)


              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23
  Author : Administrator

  Use RTTI to find instances of Eugen::IA::TStrategicOrderManager
  current turn = TStrategicOrderManager+68
}

[ENABLE]

aobscanmodule(GetCurrentTurnAOB,$process,48 8B 05 ** ** ** ** 8B 40 68 89 45 2C B1 19 31 D2)

              <ID>969</ID>
              <Description>"Player's Fatigue Points Always Zero (takes effect after battle)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v189668
  Date   : 2026-05-09
  Author : Administrator

  Fatigue points is 4-byte integer,  at TStrategicFatigueModule+18
  It appears max fatigue pts is stored at Eugen::IA::TStrategicFatigueModuleDescriptor+30

}

[ENABLE]
aobscanmodule(WriteStrategicFatigueAOB,$process,8B 40 30 39 C6 0F 43 F0 89 77 18 48 89 F9) // should be unique
alloc(newmem2,$1000)

label(code2)
label(return2)
label(cleanup)

newmem2:
  // run part of the orig codes first
  mov eax,[rax+30]
  cmp esi,eax
  cmovae esi,eax

  // rdi = start of unit's instance of Eugen::IA::TStrategicFatigueModule
  // HumanPlayerTeamID = example 0000000002030000,0000000002040000,0000000002050000,etc
  // ArrayOfTeamLinkModule = start address of array of Eugen::IA::TLinkTeamModule instances

  // don't use rdi/rsi
  push r13
  push r14
  push rdx
  mov rdx,[rdi+8]  // get raw unit ID from TStrategicFatigueModule
  cmp rdx,-1  // check if register is 0xFFFFFFFFFFFFFFFF
  je cleanup
  shr rdx,28
  and edx,007FFFFF
  mov r13,ArrayOfTeamLinkModuleSize
  mov r14,[r13]
  cmp edx,r14d   // make sure array index doesn't cause us to exceed array size
  jae cleanup    // jmp to exit if unitID above or equal to max unitID
  // if we reach here, rdx is ready to be used as array index

  mov r13,ArrayOfTeamLinkModule
  mov r14,[r13]
  mov r14,[r14+rdx*8]
  and r14,-02  // now r14 has the Eugen::IA::TLinkTeamModule instance of affected unit
  test r14,r14  // test if we got some zero garbage
  je cleanup

  // compare the unit ID from TStrategicFatigueModule with the one from TLinkTeamModule
  mov rdx,[r14+8]   // r14 = affected unit ID from TLinkTeamModule
  cmp [rdi+8],rdx
  jne cleanup       // get out man, somethin not right here if don't match

  mov r13,HumanPlayerTeamID
  mov rdx,[r13]
  cmp [r14+18],rdx  // take faction ID from TLinkTeamModule and compare it against HumanPlayerTeamID
  jne cleanup       // jump if not human player, no cheats for u
  xor esi,esi       // set Fatigue Points to zero for player
cleanup:
  pop rdx
  pop r14
  pop r13
code2:
  // continue with rest of orig code
  mov [rdi+18],esi
  mov rcx,rdi
  jmp return2

WriteStrategicFatigueAOB:
  jmp far newmem2
return2:
registersymbol(WriteStrategicFatigueAOB)

[DISABLE]

WriteStrategicFatigueAOB:
  db 8B 40 30 39 C6 0F 43 F0 89 77 18 48 89 F9


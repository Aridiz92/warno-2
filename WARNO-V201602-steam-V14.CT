            <CheatEntry>
              <ID>931</ID>
              <Description>"Unit Health and Cohesion Always Full (Player only)"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v178863
  Date   : 2026-01-25
  Author : Administrator

  AOB: Conventional dmg/supression

  TBaseDamageModule + 24 = (float)Max suppression
  TBaseDamageModule + 28 = (float)current suppression   (zero means NO supression)
  TBaseDamageModule + 3C = (float)Max damage
  TBaseDamageModule + 40 = (float)damage taken so far   (zero means NO damage, i.e full health)

  How to locate the function that writes dmg/suppression:

  1) Find what writes to 'damage taken so far', the function you land in is used to write both dmg &amp; supression
     It seems, inside this function, if rdx=0 then write to supression
                                     if rdx=1 then write to dmg
     push rbp
     mov rbp,rsp
     movsxd  rax,edx   &lt;---rdx
     lea rax,[rax+rax*2]
     movss xmm0,[rcx+rax*8+28]

  2) Or, use RTTI to find vtable pointer for Eugen::IA::TProjectileUpdater
  Eugen::IA::WorldUpdater::TWorldUpdaterGameSpecific_TacticalGameplay + 458 = pointer to TProjectileUpdater
  In the vtable list of TProjectileUpdater, start with the vfunction at offset +18
  The path to our desired func as follows:-
  WARNO.exe+6226F8 - jmp qword ptr [rax+18]
    WARNO.exe+B827A0 - push r15
    (...+4EF bytes later) WARNO.exe+B82C8F - call WARNO.exe+735280
      WARNO.exe+735632 - call WARNO.exe+736510  &lt;---the func we want
}

[ENABLE]
aobscanmodule(DamageAOB,$process,F3 0F 11 10 5D)
alloc(newmem1,$1000,DamageAOB)

label(code1)
label(return1)
label(cleanup1)
label(DamageAOB_bytes)

// ArrayOfTeamLinkModule = start address of array of Eugen::IA::TLinkTeamModule instances
// HumanPlayerTeamID = example 0000000002030000,0000000002040000,0000000002050000,etc

newmem1:
  // proceed with orig codes first
  readmem(DamageAOB,5)
  { movss [rax],xmm2  // xmm2 = amount of health/supress to add
    pop rbp }

  // Always check if rcx is Eugen::IA::TBaseDamageModule
  // Also check if xmm2 = amount of health/suppression to add
  // rcx+8 contains unit ID that took dmg, eg. 00000000001F0100

  // don't modify rcx
  push r13
  push r14
  push r15
  push rax
  mov r15,[rcx+8]  // get raw unit ID from TBaseDamageModule
  shr r15,28
  and r15d,007FFFFF  // now r15 is ready to be used as array index

  mov r13,ArrayOfTeamLinkModule
  mov r14,[r13]
  mov r14,[r14+r15*8]
  and r14,-02  // now r14 has the Eugen::IA::TLinkTeamModule instance of affected unit
  test r14,r14  // test if we got some zero garbage
  je cleanup1
  cmp r14,-1  // check if register is 0xFFFFFFFFFFFFFFFF
  je cleanup1

  // compare the unit ID from TBaseDamageModule with the one from TLinkTeamModule
  mov r15,[r14+8]   // r14 = affected unit ID from TLinkTeamModule
  cmp [rcx+8],r15
  jne cleanup1       // get out man, somethin not right here if don't match

  mov r13,HumanPlayerTeamID
  mov r15,[r13]
  cmp [r14+20],r15  // take faction ID from TLinkTeamModule and compare it against HumanPlayerTeamID
  jne cleanup1       // jump if not human player, no cheats for u
  xorps xmm2,xmm2   // human player, no damage/supression added
  movss [rcx+40],xmm2   // damage=0 which means full health
  movss [rcx+28],xmm2   // supression=0 which means high cohesion
  movss [rcx+58],xmm2   // experimental, possibly supression-related

cleanup1:
  pop rax
  pop r15
  pop r14
  pop r13
code1:
  jmp return1

DamageAOB_bytes:
  readmem(DamageAOB,5)

DamageAOB:
  jmp newmem1
return1:
registersymbol(DamageAOB DamageAOB_bytes)

[DISABLE]
DamageAOB:
  readmem(DamageAOB_bytes,5)

unregistersymbol(*)
dealloc(*)

{

      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : WARNO.exe
  Version: v189668
  Date   : 2026-05-09
  Author : Administrator

  PlayerManualDeployAOB = a location that only gets executed if player manually deploys/cancels a unit, visible in stack
  GetPlayerTeamID = AOB that gets a pointer to Eugen::IA::TGameplayServices , player's teamID is at TGameplayServices+30
  GetArrayOfTeamLinkModuleAOB = AOB that gets the start address of array of Eugen::IA::TLinkTeamModule instances
}

[ENABLE]
aobscanmodule(PlayerManualDeployMatchAOB,$process,FF 50 40 FF ?? 75 E9 E9 ?? ?? FF FF)
define(PlayerManualDeployAOB,PlayerManualDeployMatchAOB+3)

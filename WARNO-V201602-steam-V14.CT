            <CheatEntry>
              <ID>962</ID>
              <Description>"Ammo Won't Decrease  (affects AI too)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v189668
  Date   : 2026-05-09
  Author : Administrator

  TAmmoStock is for each weapon
  look for function that deducts ammo clip, not from ammo stock. Ammo clip = Salvo Length
  TAmmoStock+30 -&gt; xxx+4 = ammo remaining in clip, then find what writes to it
}

[ENABLE]

aobscanmodule(Ammo1_AOB,$process,8B ?? 04 39 ?? 89 ?? 0F 4C ?? 29 ?? 89 ?? 04)
alloc(newmem,$1000)

label(code)

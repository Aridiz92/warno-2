            <CheatEntry>
              <ID>1016</ID>
              <Description>"Army General - Tactical Battles (Team Score, Team Morale)"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23

  This script collects pointer to structure containing team score &amp; units lost addresses for Army General tactical battles
  AOB accesses each team's Eugen::IA::TTeamScoreModule via rcx
  Use RTTI to get instances of Eugen::IA::TTeamScoreModule, and check what accesses TTeamScoreModule+20
  TTeamScoreModule layout (structure is 0x50 bytes):
     +8  team ID      (8 bytes hex)
     +1C score representing units lost  (int32)
     +20 team score      (int32)
}

[ENABLE]
aobscanmodule(ArmyGeneralStatsAOB,$process,C1 E8 05 25 F8 FF FF 03 48 8B 04 01 48 83 E0 FE 44 03 ?? 20) // should be unique
alloc(newmem,$1000)
alloc(PtrArmyGeneralStats,8)

registersymbol(PtrArmyGeneralStats)
label(code)
label(return)
label(ArmyGeneralStatsAOB_bytes)

newmem:
// we want to capture rcx, it's pointing to array of TTeamScoreModule instances
  push r15
  mov r15,PtrArmyGeneralStats
  mov [r15],rcx
  pop r15
code:
  // proceed with orig codes
  readmem(ArmyGeneralStatsAOB,16)
  {  shr eax,05
     and eax,03FFFFF8
     mov rax,[rcx+rax]
     and rax,-02 }
  jmp return

ArmyGeneralStatsAOB_bytes:
  readmem(ArmyGeneralStatsAOB,16)

ArmyGeneralStatsAOB:
  jmp far newmem
  nop 2
return:
registersymbol(ArmyGeneralStatsAOB ArmyGeneralStatsAOB_bytes)

[DISABLE]
ArmyGeneralStatsAOB:
  readmem(ArmyGeneralStatsAOB_bytes,16)

unregistersymbol(*)
dealloc(*)


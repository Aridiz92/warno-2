    <CheatEntry>
      <ID>274</ID>
      <Description>"Debug/Testing/RTTI"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>0000FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>752</ID>
          <Description>"Unlimited Human Player Units (For manual deployment)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : WARNO.exe
  Version:
  Date   :
  Author : Administrator

  Infinite Units for player when manually deploying. credits to TheOrchidStation from playground.ru for initial discovery of these AOBs

  ARMY GENERAL TACTICAL BATTLES
  WARNO.exe+1515AAC - add [rcx+rdi*4],eax  &lt;&lt; increase number of units deployed (Army General)
  WARNO.exe+150F997 - dec [rax+rbx*4]      &lt;&lt; decrease number of units deployed (Army General) no need to touch, for now

  SKIRMISH / Operations
  WARNO.exe+A15C6B - sub [r14+20],ebp   &lt;&lt; deduct unit from pool after player confirms deployment
  WARNO.exe+A13A42 - add [r15+20],ebp   &lt;&lt; refund deployed unit to pool  (AI doesn't seem to use this)
  Deducts units from TCurrentWargameNationDeck+8 -&gt; +8 -&gt; pointers to various battlegroups
}

[ENABLE]
aobscanmodule(UnlimitedUnitsAOB1,$process,4C ?? ?? ?? 49 C1 ?? ?? 4A ?? ?? ?? 89 ?? 01 04 B9)
//aobscanmodule(UnlimitedUnitsAOB2,$process,FF ?? ?? 49 83 ?? ?? 49 39 ?? 0F 84 ?? ?? ?? ?? 45 8B)
aobscanmodule(UnlimitedUnitsAOB3,$process,41 29 ?? 20 48 89 ?? 48 89 ?? E8)
aobscanmodule(UnlimitedUnitsAOB4,$process,41 01 ?? ?? 4D ?? ?? 0F 84 ?? ?? ?? ?? 41 8B)

alloc(newmem1,$1000)
alloc(newmem3,$1000,UnlimitedUnitsAOB3)
label(code1)
label(return1)
label(UnlimitedUnitsAOB1_bytes)
label(cleanup3)
label(return3)
label(loopingChk)
label(UnlimitedUnitsAOB3_bytes)

newmem1:
  readmem(UnlimitedUnitsAOB1,14)  // orig code
  { lea r15,[rcx+rcx*2]
  shl r15,04
  mov rcx,[rdx+r15]
  mov edi,edi }
code1:
  xor eax,eax  // don't increase number of units deployed (Army General)
  jmp return1

UnlimitedUnitsAOB1_bytes:
  readmem(UnlimitedUnitsAOB1,14)

UnlimitedUnitsAOB1:
  jmp far newmem1
return1:
registersymbol(UnlimitedUnitsAOB1 UnlimitedUnitsAOB1_bytes)

newmem3:
  push r9
  push rdx
  pushfq
  mov rdx,PlayerManualDeployAOB
  xor r9,r9

loopingChk:     // check the stack for presence of PlayerManualDeployAOB, up to rsp+0xA00
  cmp [rsp+r9*8+18],rdx
  je cleanup3       // don't deduct unit if human player, skip the sub instruction
  inc r9
  cmp r9,140
  jne loopingChk
  reassemble(UnlimitedUnitsAOB3)     // sub [r14+20],ebp  // orig code
  jmp cleanup3

cleanup3:
  popfq
  pop rdx
  pop r9
  reassemble(UnlimitedUnitsAOB3+4)  // mov rcx,rbx       // orig code
  jmp return3

UnlimitedUnitsAOB3_bytes:
  readmem(UnlimitedUnitsAOB3,7)

UnlimitedUnitsAOB3:
  jmp newmem3
  nop 2
return3:
registersymbol(UnlimitedUnitsAOB3 UnlimitedUnitsAOB3_bytes)

UnlimitedUnitsAOB4:
  db 90 90 90 90
registersymbol(UnlimitedUnitsAOB4)

[DISABLE]
UnlimitedUnitsAOB1:
  readmem(UnlimitedUnitsAOB1_bytes,14)

UnlimitedUnitsAOB3:
  readmem(UnlimitedUnitsAOB3_bytes,7)

UnlimitedUnitsAOB4:
  db 41 01 6F 20

unregistersymbol(*)
dealloc(*)

{
// ORIGINAL CODE - INJECTION POINT: WARNO.exe+1515AAC

WARNO.exe+1515A75: 0F 86 79 00 00 00     - jbe WARNO.exe+1515AF4
WARNO.exe+1515A7B: 83 FF FF              - cmp edi,-01
WARNO.exe+1515A7E: 74 6A                 - je WARNO.exe+1515AEA
WARNO.exe+1515A80: 89 D9                 - mov ecx,ebx
WARNO.exe+1515A82: 8B 45 E8              - mov eax,[rbp-18]
WARNO.exe+1515A85: 48 8B 5D E0           - mov rbx,[rbp-20]
WARNO.exe+1515A89: 8B 96 10 01 00 00     - mov edx,[rsi+00000110]
WARNO.exe+1515A8F: 4C 8B 86 C8 00 00 00  - mov r8,[rsi+000000C8]
WARNO.exe+1515A96: 4C 8D 34 52           - lea r14,[rdx+rdx*2]
WARNO.exe+1515A9A: 4B 8B 14 F0           - mov rdx,[r8+r14*8]
// ---------- INJECTING HERE ----------
WARNO.exe+1515A9E: 4C 8D 3C 49           - lea r15,[rcx+rcx*2]
WARNO.exe+1515AA2: 49 C1 E7 04           - shl r15,04
WARNO.exe+1515AA6: 4A 8B 0C 3A           - mov rcx,[rdx+r15]
WARNO.exe+1515AAA: 89 FF                 - mov edi,edi
// ---------- DONE INJECTING  ----------
WARNO.exe+1515AAC: 01 04 B9              - add [rcx+rdi*4],eax &lt;------
WARNO.exe+1515AAF: 48 85 C0              - test rax,rax
WARNO.exe+1515AB2: 74 40                 - je WARNO.exe+1515AF4
WARNO.exe+1515AB4: 4C 8D 24 83           - lea r12,[rbx+rax*4]
WARNO.exe+1515AB8: 48 C1 E7 04           - shl rdi,04
WARNO.exe+1515ABC: 0F 1F 40 00           - nop dword ptr [rax+00]
WARNO.exe+1515AC0: 48 8B 86 C8 00 00 00  - mov rax,[rsi+000000C8]
WARNO.exe+1515AC7: 4A 8B 04 F0           - mov rax,[rax+r14*8]
WARNO.exe+1515ACB: 4A 8B 4C 38 18        - mov rcx,[rax+r15+18]
WARNO.exe+1515AD0: 48 01 F9              - add rcx,rdi
WARNO.exe+1515AD3: 48 89 DA              - mov rdx,rbx
}


{
// ORIGINAL CODE - INJECTION POINT: WARNO.exe+A15C6B

WARNO.exe+A15C4E: 4C 89 F1        - mov rcx,r14
WARNO.exe+A15C51: 48 89 FA        - mov rdx,rdi
WARNO.exe+A15C54: E8 97 AD 00 00  - call WARNO.exe+A209F0
WARNO.exe+A15C59: 84 C0           - test al,al
WARNO.exe+A15C5B: 75 E3           - jne WARNO.exe+A15C40
WARNO.exe+A15C5D: 8B 47 18        - mov eax,[rdi+18]

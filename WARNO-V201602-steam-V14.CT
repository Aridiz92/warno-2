WARNO.exe+A13A70: 48 C1 E5 02        - shl rbp,02
}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>251</ID>
          <Description>"EXPERIMENTAL HACK : Prevent frozen values below from affecting AG campaign scores"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : WARNO.exe
  Version:
  Date   :
  Author : Administrator

  This script is an experimental ugly hack to prevent spillover of tactical battle scores into AG campaign scores.
  For people who forget to unfreeze tactical scores/morale before exiting tac battle summary screen.

  no longer working since v135139xxx

  140B03BC6 - F3 0F6F 44 10 20  - movdqu xmm0,[rax+rdx+20]
  140AC5C68 - F3 0F6F 46 18  - movdqu xmm0,[rsi+18]

}

[ENABLE]

aobscanmodule(PreventSpilloverTacticalScoreIntoCampaignScoreAOB,$process,44 03 41 1C 44 03 41 20 44 03 41 24 44 03 41 28 44 03 41 2C BA 06) // should be unique
alloc(newmem,$1000,PreventSpilloverTacticalScoreIntoCampaignScoreAOB)

label(code)
label(return)

newmem:

code:
  // add r8d,[rcx+1C]
  // add r8d,[rcx+20]
  jmp return

PreventSpilloverTacticalScoreIntoCampaignScoreAOB:
  jmp newmem
  nop 3
return:
registersymbol(PreventSpilloverTacticalScoreIntoCampaignScoreAOB)

[DISABLE]

PreventSpilloverTacticalScoreIntoCampaignScoreAOB:
  db 44 03 41 1C 44 03 41 20

unregistersymbol(PreventSpilloverTacticalScoreIntoCampaignScoreAOB)
dealloc(newmem)

{

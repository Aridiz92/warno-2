            <CheatEntry>
              <ID>1027</ID>
              <Description>"Unlimited Human Player Units (For manual deployment)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23
  Author : Administrator

  Infinite Units for player when manually deploying. credits to TheOrchidStation from playground.ru for initial discovery of these AOBs

  ARMY GENERAL TACTICAL BATTLES (AI doesn't seem to use this)
  WARNO.exe+146D830 - add [rcx+rdi*4],eax  &lt;&lt; increase number of units deployed (Army General) - scan 4 increase right after clicking unit
  WARNO.exe+1467583 - dec [rax+rbx*4]      &lt;&lt; decrease number of units deployed (Army General) - scan 4 decrease right after un-deploying unit , no need to use this for now. Cause it doesn't appear to be called if we didn't increase when deploying unit

  SKIRMISH / Operations
  WARNO.exe+A92D17 - sub [r14+20],edi   &lt;&lt; deduct unit from pool after player confirms deployment
  WARNO.exe+A90758 - add [r15+20],eax   &lt;&lt; refund deployed unit to pool  (AI doesn't seem to use this)
  Deducts units from TCurrentWargameNationDeck+8 -&gt; +8 -&gt; pointers to various battlegroups
}

[ENABLE]
aobscanmodule(UnlimitedUnitsAOB1,$process,4C ?? ?? ?? 49 C1 ?? ?? 4A ?? ?? ?? 89 ?? 01 04 B9)
//aobscanmodule(UnlimitedUnitsAOB2,$process,4A 8B 04 E8 4A 8B 04 20 FF 0C 98 49 83 C7 04)
aobscanmodule(UnlimitedUnitsAOB3,$process,41 29 ?? 20 48 89 ?? 48 83 C4 ??)
aobscanmodule(UnlimitedUnitsAOB4,$process,8B 45 E8 41 01 47 20 0F)

alloc(newmem1,$1000)
alloc(newmem3,$1000,UnlimitedUnitsAOB3)
alloc(newmem4,$1000,UnlimitedUnitsAOB4)
label(code1)
label(return1)
label(UnlimitedUnitsAOB1_bytes)
label(cleanup3)
label(return3)
label(cleanup4)
label(return4)
label(loopingChk3)
label(loopingChk4)
label(UnlimitedUnitsAOB3_bytes)
label(UnlimitedUnitsAOB4_bytes)

newmem1:
  readmem(UnlimitedUnitsAOB1,14)  // orig code
  { lea r15,[rcx+rcx*2]
  shl r15,04
  mov rcx,[rdx+r15]
  mov edi,edi }
code1:
  xor eax,eax  // don't increase number of units deployed (Army General)
  jmp return1

UnlimitedUnitsAOB1_bytes:
  readmem(UnlimitedUnitsAOB1,14)

UnlimitedUnitsAOB1:
  jmp far newmem1
return1:
registersymbol(UnlimitedUnitsAOB1 UnlimitedUnitsAOB1_bytes)

newmem3:
  push r9
  push rdx
  pushfq
  mov rdx,PlayerManualDeployAOB
  xor r9,r9

loopingChk3:     // check the stack for presence of PlayerManualDeployAOB, up to rsp+0xA00
  cmp [rsp+r9*8+18],rdx
  je cleanup3       // don't deduct unit if human player, skip the sub instruction
  inc r9
  cmp r9,140
  jne loopingChk3
  reassemble(UnlimitedUnitsAOB3)     // sub [r14+20],edi  // orig code
  jmp cleanup3

cleanup3:
  popfq
  pop rdx
  pop r9
  reassemble(UnlimitedUnitsAOB3+4)  // mov rcx,rsi       // orig code
  jmp return3

UnlimitedUnitsAOB3_bytes:
  readmem(UnlimitedUnitsAOB3,7)

UnlimitedUnitsAOB3:
  jmp newmem3
  nop 2
return3:
registersymbol(UnlimitedUnitsAOB3 UnlimitedUnitsAOB3_bytes)

newmem4:
  // run some orig code first
  mov eax,[rbp-18]

  push r9
  push rdx
  pushfq
  mov rdx,PlayerManualDeployAOB
  xor r9,r9

loopingChk4:     // check the stack for presence of PlayerManualDeployAOB, up to rsp+0xA00
  cmp [rsp+r9*8+18],rdx
  je cleanup4       // no need refund unit if human player, skip the add instruction
  inc r9
  cmp r9,140
  jne loopingChk4
  reassemble(UnlimitedUnitsAOB4+3)     // add [r15+20],eax  // orig code
  jmp cleanup4

cleanup4:
  popfq
  pop rdx
  pop r9
  jmp return4

UnlimitedUnitsAOB4_bytes:
  readmem(UnlimitedUnitsAOB4,7)

UnlimitedUnitsAOB4:
  jmp newmem4
  nop 2
return4:
registersymbol(UnlimitedUnitsAOB4 UnlimitedUnitsAOB4_bytes)

[DISABLE]
UnlimitedUnitsAOB1:
  readmem(UnlimitedUnitsAOB1_bytes,14)

UnlimitedUnitsAOB3:
  readmem(UnlimitedUnitsAOB3_bytes,7)

UnlimitedUnitsAOB4:
  readmem(UnlimitedUnitsAOB4_bytes,7)

unregistersymbol(*)
dealloc(*)


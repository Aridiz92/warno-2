            <CheatEntry>
              <ID>1032</ID>
              <Description>"Damage Multiplier (Human Player Only) x5"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23
  Author : Administrator

  This script multiplies dmg done by human plyr units
  We inject two levels above the call that writes damage/supression and check rbp for attacker's unit ID

  As of current game version, at WARNO.exe+7C157D - call WARNO.exe+7C1040, rbp is pointing to attacker's unit ID

}

[ENABLE]
aobscanmodule(DmgMultiplierAOB,$process,F3 0F 5C 47 40 F3 0F 2C D8 48 89 F9 0F 28 CF E8) // should be unique
alloc(newmem,$1000)

label(code)
label(cleanup)
label(return)
label(multiplier)
label(DmgMultiplierAOB_bytes)

newmem:
  // run orig codes first
  readmem(DmgMultiplierAOB,15)
  {   subss xmm0,[rdi+40]
  cvttss2si ebx,xmm0
  mov rcx,rdi
  movaps xmm1,xmm7  }

  // Always check if rcx is Eugen::IA::TBaseDamageModule
  // Also check if xmm1 = amount of health/suppression to add
  // rcx+8 contains unit ID that took dmg, eg. 00000000001F0100
  // rbp should be pointing to attacker's unit ID

  // don't modify rcx &amp; rbp
  push r13
  push r14
  push r15
  mov r15,[rbp]  // get attacker's unit ID from rbp
  cmp r15,-1  // check if register is 0xFFFFFFFFFFFFFFFF
  je cleanup
  shr r15,28
  and r15d,007FFFFF
  mov r13,ArrayOfTeamLinkModuleSize
  mov r14,[r13]
  cmp r15d,r14d   // make sure array index doesn't cause us to exceed array size
  jae cleanup    // jmp to exit if unitID above or equal to max unitID
  // if we reach here, r15 is ready to be used as array index

  mov r13,ArrayOfTeamLinkModule
  mov r14,[r13]
  mov r14,[r14+r15*8]
  and r14,-02  // now r14 has the Eugen::IA::TLinkTeamModule instance of attacker unit
  test r14,r14  // test if we got some zero garbage
  je cleanup
  cmp r14,-1  // check if register is 0xFFFFFFFFFFFFFFFF
  je cleanup

  // compare the attacker unit ID(rbp) with the one from TLinkTeamModule
  mov r15,[r14+8]   // r14+8 = attacker's unit ID from TLinkTeamModule
  mov r13,[rbp]
  cmp r13,r15
  jne cleanup       // get out man, somethin not right here if don't match

  mov r13,HumanPlayerTeamID
  mov r15,[r13]
  cmp [r14+18],r15  // take faction ID from TLinkTeamModule and compare it against HumanPlayerTeamID
  jne cleanup       // if attacker not human, don't alter damage
  mulss xmm1,[multiplier]   // attacker is human, apply dmg multiplier cheat

cleanup:
  pop r15
  pop r14
  pop r13
code:
  jmp return

DmgMultiplierAOB_bytes:
  readmem(DmgMultiplierAOB,15)

align 10 CC
multiplier:
  dd (float)5.0    // multiplier , you can change to whatever positive float number u want

DmgMultiplierAOB:
  jmp far newmem
  nop
return:
registersymbol(DmgMultiplierAOB DmgMultiplierAOB_bytes)

[DISABLE]
DmgMultiplierAOB:
  readmem(DmgMultiplierAOB_bytes,15)

unregistersymbol(*)
dealloc(*)

{
// ORIGINAL CODE - INJECTION POINT: WARNO.exe+79F84E

WARNO.exe+79F821: 48 8B 00                 - mov rax,[rax]
WARNO.exe+79F824: 48 89 45 D0              - mov [rbp-30],rax
WARNO.exe+79F828: F3 44 0F 11 54 24 20     - movss [rsp+20],xmm10
WARNO.exe+79F82F: 48 8D 4D D8              - lea rcx,[rbp-28]

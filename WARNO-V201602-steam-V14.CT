              <Description>"Action Pts Don't Decrease (Deactivate Before ending your turn!)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23

  Action Pts stored in float at Eugen::IA::TActionPointsModule + 40
}

[ENABLE]

aobscanmodule(AG_ActionPtsAOB,$process,F3 0F 5C F9 0F 57 C0 F3 0F 5F F8 F3 0F 11 79 40) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

// rcx = Batallion's Eugen::IA::TActionPointsModule

newmem:
  xorps xmm1,xmm1
code:
  subss xmm7,xmm1
  xorps xmm0,xmm0
  maxss xmm7,xmm0
  movss [rcx+40],xmm7
  jmp return

AG_ActionPtsAOB:
  jmp far newmem
  nop 2
return:
registersymbol(AG_ActionPtsAOB)

[DISABLE]


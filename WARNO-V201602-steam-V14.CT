      <CheatEntries>
        <CheatEntry>
          <ID>1012</ID>
          <Description>"Tactical Battles"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1013</ID>
              <Description>"Command/Requisition Pts (activate, then manually deploy a unit that has cost to capture pointer)"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23
  Author : Administrator

  This script gets AOB that writes to player's cmd/req pts
  Cmd/Requisition Pts = Eugen::IA::TTeamCurrencyManagerModule -&gt; some calc -&gt; someAddr+08 -&gt; finalBaseAddr+14
  and new since version_150731: some upper limit for CmdPts (specified at finalBaseAddr+10) in AG Tactical battles
}

[ENABLE]
aobscanmodule(CmdPtsAOB,$process,4? 8B ?? ?? 4? 8B 78 08 4? 8B ?? 10 4? 89 F? E8 ?? ?? ?? FF) // should be unique
alloc(newmem1,$1000)
alloc(PtrToCommandPts,8)

label(code1)
label(return)
label(presenceFound)
label(cleanup)
label(loopingChk)
label(CmdPtsAOB_bytes)

newmem1:
  // run orig code first
  reassemble(CmdPtsAOB)        // mov rax,[rbp+00]
  reassemble(CmdPtsAOB+4)      // mov rdi,[rax+08]
  reassemble(CmdPtsAOB+4+4)    // mov r14d,[rdi+10]
  reassemble(CmdPtsAOB+4+4+4)  // mov rcx,rdi

  // check the stack for presence of PlayerManualDeployAOB, up to rsp+0xA00
  push rdi
  push rax
  pushfq
  mov rdi,PlayerManualDeployAOB
  xor rax,rax

loopingChk:
  cmp [rsp+rax*8+20],rdi
  je presenceFound
  inc eax
  cmp eax,140
  jne loopingChk
  jmp cleanup

presenceFound:
  // If we arrived here, that means PlayerManualDeployAOB was found in stack and action was initiated by human player
  popfq
  pop rax
  pop rdi
  mov [PtrToCommandPts],rcx   // rcx+14 = player's cmdPts,  rcx+10 = max upper limit of cmdPts
  jmp code1

cleanup:
  popfq
  pop rax
  pop rdi
  jmp code1

code1:
  jmp return

CmdPtsAOB_bytes:
  readmem(CmdPtsAOB,15)

CmdPtsAOB:
  jmp far newmem1
  nop
return:
registersymbol(CmdPtsAOB CmdPtsAOB_bytes PtrToCommandPts)

[DISABLE]
CmdPtsAOB:
  readmem(CmdPtsAOB_bytes,15)


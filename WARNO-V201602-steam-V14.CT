      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : WARNO.exe
  Version: v201602
  Date   : 2026-08-23
  Author : Administrator

  PlayerManualDeployAOB = a location that only gets executed if player manually deploys/cancels a unit, visible in stack. Eugen::IA::TNetworkActionManager vft+40
  GetPlayerTeamID = AOB that gets a pointer to Eugen::IA::TGameplayServices , player's teamID is at TGameplayServices+30
  GetArrayOfTeamLinkModuleAOB = AOB that gets the start address of array of Eugen::IA::TLinkTeamModule instances
}

[ENABLE]
aobscanmodule(PlayerManualDeployMatchAOB,$process,FF 50 40 FF ?? 75 E9 E9 ?? ?? FF FF)
define(PlayerManualDeployAOB,PlayerManualDeployMatchAOB+3)
registersymbol(PlayerManualDeployMatchAOB PlayerManualDeployAOB)

aobscanmodule(GetPlayerTeamID,$process,48 8B 05 ** ** ** ** 48 8D 48 F8 48 85 C0 48 0F 44 C8 0F 28 CE)
alloc(newmem2,$1000,GetPlayerTeamID)
alloc(HumanPlayerTeamID,8)

aobscanmodule(GetArrayOfTeamLinkModuleAOB,$process,C1 E8 05 25 F8 FF FF 03 48 8B 04 03 48 83 E0 FE 48 8B ?? 18 48 89 ?? 48 89 ?? 48 83 ??)
alloc(newmem3,$1000,GetArrayOfTeamLinkModuleAOB)
alloc(ArrayOfTeamLinkModule,8)
alloc(ArrayOfTeamLinkModuleSize,8)

label(code2)
label(return2)
label(GetPlayerTeamID_bytes)
label(code3)
label(return3)
label(GetArrayOfTeamLinkModuleAOB_bytes)

newmem2:
  // run orig code first
  // [WARNO.exe+3389700] = pointer to Eugen::IA::TGameplayServices
  reassemble(GetPlayerTeamID+7)    // lea rcx,[rax-08]
  reassemble(GetPlayerTeamID+7+4)  // test rax,rax
  reassemble(GetPlayerTeamID+7+4+3) // cmove rcx,rax
  reassemble(GetPlayerTeamID+7+4+3+4)  // movaps xmm1,xmm6

code2:
  push r15
  mov r15,[rax+30]
  mov [HumanPlayerTeamID],r15
  pop r15
  jmp return2

GetPlayerTeamID_bytes:
  readmem(GetPlayerTeamID+7,14)

GetPlayerTeamID+7:
  jmp far newmem2
return2:
registersymbol(GetPlayerTeamID GetPlayerTeamID_bytes HumanPlayerTeamID)

newmem3:
  // WARNO.exe+31FD2C8 is TEntityIdIndexedContainer&lt; ?? ::TVectorWithInSituStorage&lt;Eugen::TPointerAndFlag&lt;Eugen::IA::TModule&gt;,0,Eugen::allocator&lt;Eugen::TPointerAndFlag&lt;Eugen::IA::TModule&gt; &gt;,Eugen::ContainerTraits::TVectorTraits&lt;Eugen::TPointerAndFlag&lt;Eugen::IA::TModule&gt; &gt; &gt; &gt;
  // WARNO.exe+31FD2D0 contains the start address of array of Eugen::IA::TLinkTeamModule instances

  // Eugen::IA::TEntityIdAllocatorBank+68 appears to contain the current max # of unit IDs, int32
  // thus, we can use it to ensure our calculated offset never exceeds the size of array of Eugen::IA::TLinkTeamModule instances
  // eg. if TEntityIdAllocatorBank+68 is 0x105, then end of array shld be at (start of array + 0x105*8)

  // Looking at mov rax,[rbx+rax], we observe rbx = start address of array of Eugen::IA::TLinkTeamModule instances
  // check that rdx contains max # of unit IDs, it shld match TEntityIdAllocatorBank+68
  // Warning - sometimes rdx may have ridiculuously small number, like 0x01 or 0x02
  // So we need 2 check for it and avoiding updating ArrayOfTeamLinkModule/ArrayOfTeamLinkModuleSize if that is the case
  pushfq
  cmp rdx,2
  jna code3
  push r8
  mov r8,ArrayOfTeamLinkModule
  mov [r8],rbx
  mov r8,ArrayOfTeamLinkModuleSize
  mov [r8],rdx
  pop r8
code3:
  popfq
  // then run orig code
  reassemble(GetArrayOfTeamLinkModuleAOB)      // shr eax,05
  reassemble(GetArrayOfTeamLinkModuleAOB+3)    // and eax,03FFFFF8
  jmp return3

GetArrayOfTeamLinkModuleAOB_bytes:
  readmem(GetArrayOfTeamLinkModuleAOB,8)

GetArrayOfTeamLinkModuleAOB:
  jmp newmem3
  nop 3
return3:
registersymbol(GetArrayOfTeamLinkModuleAOB GetArrayOfTeamLinkModuleAOB_bytes ArrayOfTeamLinkModule ArrayOfTeamLinkModuleSize)

[DISABLE]
GetPlayerTeamID+7:
  readmem(GetPlayerTeamID_bytes,14)

GetArrayOfTeamLinkModuleAOB:
  readmem(GetArrayOfTeamLinkModuleAOB_bytes,8)


WARNO.exe+BA4FD7: 48 8D 6C 24 20  - lea rbp,[rsp+20]
WARNO.exe+BA4FDC: 89 D6           - mov esi,edx
WARNO.exe+BA4FDE: 48 89 CF        - mov rdi,rcx
WARNO.exe+BA4FE1: 03 71 18        - add esi,[rcx+18]
WARNO.exe+BA4FE4: 48 8B 51 08     - mov rdx,[rcx+08]
WARNO.exe+BA4FE8: 0F B6 49 10     - movzx ecx,byte ptr [rcx+10]
WARNO.exe+BA4FEC: E8 4F E3 A1 FF  - call WARNO.exe+5C3340

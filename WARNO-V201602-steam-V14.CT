</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>977</ID>
          <Description>"RTTI (Main Process Space only)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>local script = [[

[ENABLE]
{$Lua}

s=createMemScan()

s.firstScan(soExactValue, vtString, rtRounded, '.?AV', '', getAddress(process) ,getAddress(process)+getAddress(getModuleSize(process)) ,"*W*X*C" ,fsmNotAligned ,'1' ,false ,true, false, true);
s.waitTillDone()

fl=createFoundList(s)

names={}
fl.initialize()

sll=createStringList()
for i=1,fl.Count do
  local a=tonumber(fl[i-1],16)
  names[i]={}
  names[i].name=readString(tonumber(fl[i-1],16)+4)
  names[i].address=a-0x10
  sll.add(names[i].name)
end

r,selstring=showSelectionList('RTTI Classes','Select the class to find instances of',sll)
if (r==-1) then return end
sll.destroy()

print("You picked "..selstring)
a=names[r+1].address
if targetIs64Bit() then
  a=a-getAddress(process)
end

fl.deinitialize()
print(string.format("Scanning for %x", a))
s=createMemScan()
s.firstScan(soExactValue, vtDword, rtRounded, string.format("%x",a), '', getAddress(process) ,getAddress(process)+getAddress(getModuleSize(process)) ,"*W*X*C" ,fsmNotAligned ,'1' ,true ,true, false, true);
s.waitTillDone()
fl=createFoundList(s)
fl.initialize()
print("found "..fl.Count.." results")

RTTIInfo={}
for i=1,fl.Count do
  local a=tonumber(fl[i-1],16)
  a=a-12
  print(string.format("%x", a))
  if readBytes(a,1)==1 then
    table.insert(RTTIInfo,a)
  end
end

print("after checking only "..#RTTIInfo.." left")

if targetIs64Bit() then
  scantype=vtQword
  pointersize=8
else
  scantype=vtDword
  pointersize=4
end

vtables={}

for i=1,#RTTIInfo do
  a=RTTIInfo[i]
  fl.deinitialize()
  print(string.format("Scanning for %x", a))
  s.firstScan(soExactValue, scantype, rtRounded, string.format("%x",a), '', getAddress(process) ,getAddress(process)+getAddress(getModuleSize(process)) ,"*W*X*C" ,fsmNotAligned ,'1' ,true ,true, false, true);
  s.waitTillDone()
  fl.initialize()

  for j=1,fl.Count do
    local b=tonumber(fl[j-1],16)+pointersize
	table.insert(vtables, b)
	print(string.format("%x", b))
  end
end

print(#vtables.." vtables found")

--scan instances

instances={}

for i=1,#vtables do
  a=vtables[i]
  fl.deinitialize()
  print(string.format("Scanning for %x", a))
  s=createMemScan()
  s.firstScan(soExactValue, scantype, rtRounded, string.format("%x",a), '', 0 ,0xffffffffffffffff ,"*W*X*C" ,fsmNotAligned ,'1' ,true ,true, false, true);
  s.waitTillDone()
  fl=createFoundList(s)
  fl.initialize()

  for j=1,fl.Count do
    table.insert(instances, tonumber(fl[j-1],16))
  end
end

print("The following instances of the class "..selstring.." where found")
for i=1,#instances do
  print(string.format("%x",instances[i]))
end

-- Find the script entry by its description name
local addresslist = getAddressList()
local memoryRecord = addresslist.getMemoryRecordByDescription("RTTI (Main Process Space only)")

-- Force disable it programmatically
memoryRecord.Active = false


[DISABLE]
]]

autoAssemble(script, true)
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>911</ID>
      <Description>"Steam v178863"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : WARNO.exe
  Version: v178863
  Date   : 2026-01-25
  Author : Administrator

  This script captures important pointers n stuff

  PlayerManualDeployAOB = a location that only gets executed if player manually deploys/cancels a unit, visible in stack
  GetPlayerTeamID = AOB that gets a pointer to Eugen::IA::TGameplayServices , player's teamID is at TGameplayServices+30
  GetArrayOfTeamLinkModuleAOB = AOB that gets the start address of array of Eugen::IA::TLinkTeamModule instances
}

[ENABLE]
aobscanmodule(PlayerManualDeployMatchAOB,$process,FF 50 40 ?? FF ?? 75 ?? E9 ?? ?? FF FF)
define(PlayerManualDeployAOB,PlayerManualDeployMatchAOB+3)
registersymbol(PlayerManualDeployMatchAOB PlayerManualDeployAOB)

aobscanmodule(GetPlayerTeamID,$process,0F 57 ?? F2 ?? ?? ?? C6 ?? ?? ?? ?? ?? 01 48 8B ?? ?? ?? ?? ?? ?? ??)
alloc(newmem2,$1000,GetPlayerTeamID)
alloc(HumanPlayerTeamID,8)

aobscanmodule(GetArrayOfTeamLinkModuleAOB,$process,C1 E8 05 25 F8 FF FF 03 48 8B 04 03 48 83 E0 FE 48 8B 40 20 48 89 06)
alloc(newmem3,$1000,GetArrayOfTeamLinkModuleAOB)
alloc(ArrayOfTeamLinkModule,8)

label(code2)
label(return2)
label(GetPlayerTeamID_bytes)
label(code3)
label(return3)
label(GetArrayOfTeamLinkModuleAOB_bytes)

newmem2:
  // run orig code first
  // [WARNO.exe+3F3BAE8] = pointer to Eugen::IA::TGameplayServices
  reassemble(GetPlayerTeamID+7)  // mov byte ptr [rsi+000000C0],01
  reassemble(GetPlayerTeamID+7+7)  // mov rdx,[WARNO.exe+3F3BAE8]

code2:
  push rax
  mov rax,[rdx+30]
  mov [HumanPlayerTeamID],rax
  pop rax
  jmp return2

GetPlayerTeamID_bytes:
  readmem(GetPlayerTeamID+7,14)

GetPlayerTeamID+7:
  jmp far newmem2
return2:
registersymbol(GetPlayerTeamID GetPlayerTeamID_bytes HumanPlayerTeamID)

newmem3:
  // ???? is TEntityIdIndexedContainer&lt; ?? :: ?? &gt;
  // found warno.exe+32CA6A8+8 is the start address of array of Eugen::IA::TLinkTeamModule instances
  // rbx = start address of array of Eugen::IA::TLinkTeamModule instances
  push r8
  mov r8,ArrayOfTeamLinkModule
  mov [r8],rbx
  pop r8
code3:
  // then run orig code
  reassemble(GetArrayOfTeamLinkModuleAOB)      // shr eax,05
  reassemble(GetArrayOfTeamLinkModuleAOB+3)    // and eax,03FFFFF8
  jmp return3

GetArrayOfTeamLinkModuleAOB_bytes:
  readmem(GetArrayOfTeamLinkModuleAOB,8)

GetArrayOfTeamLinkModuleAOB:
  jmp newmem3
  nop 3
return3:
registersymbol(GetArrayOfTeamLinkModuleAOB GetArrayOfTeamLinkModuleAOB_bytes ArrayOfTeamLinkModule)

[DISABLE]
GetPlayerTeamID+7:
  readmem(GetPlayerTeamID_bytes,14)

GetArrayOfTeamLinkModuleAOB:
  readmem(GetArrayOfTeamLinkModuleAOB_bytes,8)

unregistersymbol(*)
dealloc(*)

{
// ORIGINAL CODE - INJECTION POINT: WARNO.exe+5F9757

WARNO.exe+5F972F: 4C 8B 6D C0           - mov r13,[rbp-40]
WARNO.exe+5F9733: 0F 84 37 FF FF FF     - je WARNO.exe+5F9670
WARNO.exe+5F9739: 0F 1F 80 00 00 00 00  - nop dword ptr [rax+00000000]
WARNO.exe+5F9740: 48 8B 45 D8           - mov rax,[rbp-28]
WARNO.exe+5F9744: 48 89 45 B8           - mov [rbp-48],rax
WARNO.exe+5F9748: 48 8B 06              - mov rax,[rsi]
WARNO.exe+5F974B: 48 89 F1              - mov rcx,rsi
WARNO.exe+5F974E: 4C 89 FA              - mov rdx,r15
WARNO.exe+5F9751: 4D 89 E0              - mov r8,r12
WARNO.exe+5F9754: 41 89 D9              - mov r9d,ebx
WARNO.exe+5F9757: FF 50 40              - call qword ptr [rax+40]  &lt;----executed when manual deploy?
// ---------- INJECTING HERE ----------
WARNO.exe+5F975A: 41 FF CE              - dec r14d
// ---------- DONE INJECTING  ----------
WARNO.exe+5F975D: 75 E1                 - jne WARNO.exe+5F9740
WARNO.exe+5F975F: E9 0C FF FF FF        - jmp WARNO.exe+5F9670
WARNO.exe+5F9764: 84 DB                 - test bl,bl
WARNO.exe+5F9766: 75 16                 - jne WARNO.exe+5F977E
WARNO.exe+5F9768: 48 8B 4E 68           - mov rcx,[rsi+68]
WARNO.exe+5F976C: 48 85 C9              - test rcx,rcx

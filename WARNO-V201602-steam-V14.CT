WARNO.exe+A15C86: 74 46           - je WARNO.exe+A15CCE
WARNO.exe+A15C88: 48 8B 10        - mov rdx,[rax]
WARNO.exe+A15C8B: 41 8D 48 FF     - lea ecx,[r8-01]
}

{
// ORIGINAL CODE - INJECTION POINT: WARNO.exe+A13A42

WARNO.exe+A13A15: 41 89 7D 08        - mov [r13+08],edi
WARNO.exe+A13A19: 41 0F 10 06        - movups xmm0,[r14]
WARNO.exe+A13A1D: 41 0F 10 4E 10     - movups xmm1,[r14+10]
WARNO.exe+A13A22: 0F 11 4C C8 10     - movups [rax+rcx*8+10],xmm1
WARNO.exe+A13A27: 0F 11 04 C8        - movups [rax+rcx*8],xmm0
WARNO.exe+A13A2B: 89 6C C8 20        - mov [rax+rcx*8+20],ebp

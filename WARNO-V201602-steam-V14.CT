newmem3:
  // WARNO.exe+3355430 is TEntityIdIndexedContainer&lt; ?? :: ?? &gt;
  // found WARNO.exe+3355430+8 is the start address of array of Eugen::IA::TLinkTeamModule instances, but can't use this fact to find start address of array of Eugen::IA::TLinkTeamModule instances
  // Eugen::IA::TEntityIdAllocatorBank+68 appears to contain the current max # of unit IDs, int32
  // thus, we can use it to ensure our calculated offset never exceeds the size of array of Eugen::IA::TLinkTeamModule instances
  // eg. if TEntityIdAllocatorBank+68 is 0x105, then end of array shld be at (start of array + 0x105*8)

  // rbx = start address of array of Eugen::IA::TLinkTeamModule instances
  // check that rdx contains max # of unit IDs, it shld match TEntityIdAllocatorBank+68
  push r8
  mov r8,ArrayOfTeamLinkModule
  mov [r8],rbx
  mov r8,ArrayOfTeamLinkModuleSize
  mov [r8],rdx
  pop r8
code3:
  // then run orig code
  reassemble(GetArrayOfTeamLinkModuleAOB)      // shr eax,05
  reassemble(GetArrayOfTeamLinkModuleAOB+3)    // and eax,03FFFFF8
  jmp return3

GetArrayOfTeamLinkModuleAOB_bytes:
  readmem(GetArrayOfTeamLinkModuleAOB,8)

GetArrayOfTeamLinkModuleAOB:
  jmp newmem3
  nop 3
return3:

            <CheatEntry>
              <ID>933</ID>
              <Description>"Damage Multiplier (Human Player Only) x5"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : WARNO.exe
  Version: v178863
  Date   : 2026-01-25
  Author : Administrator

  This script multiplies dmg done by human plyr units
  We inject just before the call that writes damage and check rbp for attacker's unit ID

  As of current game version, at WARNO.exe+767011 - call WARNO.exe+766A90, rbp is pointing to attacker's unit ID

}

[ENABLE]
aobscanmodule(DmgMultiplierAOB,$process,F3 41 0F 5C 45 40 F3 0F 2C F8 4C 89 E9 0F 28 CF) // should be unique
alloc(newmem,$1000)

label(code)
label(cleanup)
label(return)
label(multiplier)
label(DmgMultiplierAOB_bytes)

newmem:
  // run orig codes first
  readmem(DmgMultiplierAOB,16)
  {   subss xmm0,[r13+40]
  cvttss2si edi,xmm0
  mov rcx,r13
  movaps xmm1,xmm7  }

  // Always check if rcx is Eugen::IA::TBaseDamageModule
  // Also check if xmm1 = amount of health/suppression to add
  // rcx+8 contains unit ID that took dmg, eg. 00000000001F0100
  // rbp should be pointing to attacker's unit ID

  // don't modify rcx &amp; rbp
  push r13
  push r14
  push r15
  push rax
  mov r15,[rbp]  // get attacker's unit ID from rbp
  mov r15,[r15]
  shr r15,28
  and r15d,007FFFFF  // now r15 is ready to be used as array index

  mov r13,ArrayOfTeamLinkModule
  mov r14,[r13]
  mov r14,[r14+r15*8]
  and r14,-02  // now r14 has the Eugen::IA::TLinkTeamModule instance of attacker unit
  test r14,r14  // test if we got some zero garbage
  je cleanup
  cmp r14,-1  // check if register is 0xFFFFFFFFFFFFFFFF
  je cleanup

  // compare the attacker unit ID(rbp) with the one from TLinkTeamModule
  mov r15,[r14+8]   // r14 = attacker's unit ID from TLinkTeamModule
  mov r13,[rbp]
  cmp [r13],r15
  jne cleanup       // get out man, somethin not right here if don't match

  mov r13,HumanPlayerTeamID
  mov r15,[r13]
  cmp [r14+20],r15  // take faction ID from TLinkTeamModule and compare it against HumanPlayerTeamID
  jne cleanup       // if attacker not human, don't alter damage
  mulss xmm1,[multiplier]   // attacker is human, apply dmg multiplier cheat

cleanup:
  pop rax
  pop r15
  pop r14
  pop r13
code:
  jmp return

DmgMultiplierAOB_bytes:
  readmem(DmgMultiplierAOB,16)

align 10 CC
multiplier:
  dd (float)5.0    // multiplier , you can change to whatever positive float number u want

DmgMultiplierAOB:
  jmp far newmem
  nop 2
return:
registersymbol(DmgMultiplierAOB DmgMultiplierAOB_bytes)

[DISABLE]
DmgMultiplierAOB:
  readmem(DmgMultiplierAOB_bytes,16)

unregistersymbol(*)
dealloc(*)


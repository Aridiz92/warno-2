WARNO.exe+5F9771: 8B 56 2C              - mov edx,[rsi+2C]
WARNO.exe+5F9774: 48 8B 01              - mov rax,[rcx]
}

{
// ORIGINAL CODE - INJECTION POINT: WARNO.exe+662965

WARNO.exe+66293B: E8 C0 64 AB FF           - call WARNO.exe+118E00
WARNO.exe+662940: F2 0F 10 7E 28           - movsd xmm7,[rsi+28]
WARNO.exe+662945: F2 0F 10 86 B8 00 00 00  - movsd xmm0,[rsi+000000B8]
WARNO.exe+66294D: 66 0F 57 C9              - xorpd xmm1,xmm1
WARNO.exe+662951: 66 0F 2E C1              - ucomisd xmm0,xmm1
WARNO.exe+662955: 72 55                    - jb WARNO.exe+6629AC
WARNO.exe+662957: 66 0F 28 D7              - movapd xmm2,xmm7
